# ==========================================
# BLOODLAB SYSTEM CONFIGURATION & ENVIRONMENT
# ==========================================

# Server Host & Port
PORT=5000
FLASK_ENV=production

# Security & Session Secret (Must be random and at least 32 characters in production)
BLOODLAB_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars-long

# Initial Super Admin Account (Seeded securely on startup)
BLOODLAB_ADMIN_USERNAME=admin
BLOODLAB_ADMIN_PASSWORD=AdminPass@2026

# Laboratory Default UPI Configuration
DEFAULT_UPI_ID=bloodlab@upi
DEFAULT_UPI_PAYEE_NAME=BloodLab Diagnostic Services

# SMS Gateway Integration (For SMS delivery of OTP in production)
# Supported options: twilio, fast2sms, mock
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=BLDLAB

# Android Keystore Signing Configuration (For Release APK and Play Store AAB Bundle)
BLOODLAB_KEYSTORE_PASSWORD=BloodLabKeystorePass2026
BLOODLAB_KEY_ALIAS=bloodlab
BLOODLAB_KEY_PASSWORD=BloodLabKeyPass2026
